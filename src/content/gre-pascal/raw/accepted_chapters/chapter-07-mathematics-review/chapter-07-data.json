{
  "sections": [
    {
      "section": "Algebra and Arithmetic",
      "topics": [
        {
          "name": "Prime Factorisation",
          "description": "Every integer greater than 1 can be expressed uniquely (up to order) as a product of prime numbers.",
          "formulas": [
            {
              "expression": "n = p_1^{a_1} p_2^{a_2} … p_k^{a_k}",
              "description": "Decompose n into its prime factors."
            }
          ]
        },
        {
          "name": "Greatest Common Divisor and Least Common Multiple",
          "description": "The greatest common divisor (gcd) of two positive integers is the largest integer dividing both numbers.  The least common multiple (lcm) is the smallest positive integer divisible by both.",
          "formulas": [
            {
              "expression": "gcd(a,b) = \\prod p_i^{\\min(a_i,b_i)}",
              "description": "Product of shared prime factors to the lowest exponents."
            },
            {
              "expression": "lcm(a,b) = \\prod p_i^{\\max(a_i,b_i)}",
              "description": "Product of all prime factors to the highest exponents."
            },
            {
              "expression": "gcd(a,b) \\times lcm(a,b) = a \\times b",
              "description": "Relates gcd and lcm for two numbers."
            }
          ]
        },
        {
          "name": "Factoring Identities",
          "description": "Standard algebraic identities useful for expanding or factoring expressions.",
          "formulas": [
            {
              "expression": "a^2 - b^2 = (a+b)(a-b)",
              "description": "Difference of squares."
            },
            {
              "expression": "(a+b)^2 = a^2 + 2ab + b^2",
              "description": "Square of a sum."
            },
            {
              "expression": "(a-b)^2 = a^2 - 2ab + b^2",
              "description": "Square of a difference."
            }
          ]
        },
        {
          "name": "Exponent Rules",
          "description": "Rules for manipulating exponents with the same base.",
          "formulas": [
            {
              "expression": "x^a \\cdot x^b = x^{a+b}",
              "description": "Product rule."
            },
            {
              "expression": "x^a / x^b = x^{a-b}",
              "description": "Quotient rule."
            },
            {
              "expression": "(x^a)^b = x^{ab}",
              "description": "Power of a power."
            },
            {
              "expression": "x^0 = 1",
              "description": "Any nonzero base raised to 0 is 1."
            },
            {
              "expression": "x^{-a} = 1 / x^a",
              "description": "Negative exponent gives the reciprocal."
            },
            {
              "expression": "x^{1/n} = \\sqrt[n]{x}",
              "description": "Fractional exponent represents an nth root."
            }
          ]
        },
        {
          "name": "Absolute Value",
          "description": "The absolute value of a real number measures its distance from zero.",
          "formulas": [
            {
              "expression": "|x| = x \\text{ if } x \\ge 0; |x| = -x \\text{ if } x < 0",
              "description": "Piecewise definition."
            }
          ]
        },
        {
          "name": "Counting and Probability",
          "description": "Formulas for enumerating arrangements and computing probabilities.",
          "formulas": [
            {
              "expression": "n!",
              "description": "Number of permutations of n distinct objects."
            },
            {
              "expression": "P(n,r) = n!/(n-r)!",
              "description": "Number of permutations of n objects taken r at a time."
            },
            {
              "expression": "C(n,r) = n!/(r!(n-r)!)",
              "description": "Number of combinations of n objects taken r at a time."
            },
            {
              "expression": "P(A) = \\text{favourable outcomes} / \\text{total outcomes}",
              "description": "Classical probability formula."
            },
            {
              "expression": "P(A \\cup B) = P(A) + P(B)",
              "description": "Addition rule for mutually exclusive events."
            },
            {
              "expression": "P(\\text{not }A) = 1 - P(A)",
              "description": "Complement rule."
            }
          ]
        }
      ]
    },
    {
      "section": "Geometry",
      "topics": [
        {
          "name": "Triangle Properties",
          "description": "Relations concerning triangles.",
          "formulas": [
            {
              "expression": "\\text{Sum of interior angles} = 180°",
              "description": "Applies to all triangles."
            },
            {
              "expression": "A = \\tfrac{1}{2} \\times \\text{base} \\times \\text{height}",
              "description": "Area of a triangle."
            },
            {
              "expression": "a^2 + b^2 = c^2",
              "description": "Pythagorean theorem for right triangles."
            }
          ]
        },
        {
          "name": "Polygon Angle Sum",
          "description": "Sum of interior angles for an n‑sided polygon.",
          "formulas": [
            {
              "expression": "(n-2) \\times 180°",
              "description": "Interior angle sum for a polygon."
            }
          ]
        },
        {
          "name": "Circle Measures",
          "description": "Formulas for circles.",
          "formulas": [
            {
              "expression": "C = 2 \\pi r",
              "description": "Circumference."
            },
            {
              "expression": "A = \\pi r^2",
              "description": "Area."
            },
            {
              "expression": "\\text{Arc length} = (\\theta/360°) \\times 2\\pi r",
              "description": "Length of an arc with central angle \\theta."
            },
            {
              "expression": "\\text{Sector area} = (\\theta/360°) \\times \\pi r^2",
              "description": "Area of a sector with central angle \\theta."
            }
          ]
        },
        {
          "name": "Solid Geometry",
          "description": "Volume formulas for common solids.",
          "formulas": [
            {
              "expression": "V_{\\text{prism}} = l \\cdot w \\cdot h",
              "description": "Rectangular prism volume."
            },
            {
              "expression": "V_{\\text{cylinder}} = \\pi r^2 h",
              "description": "Volume of a cylinder."
            },
            {
              "expression": "V_{\\text{sphere}} = \\tfrac{4}{3} \\pi r^3",
              "description": "Volume of a sphere."
            },
            {
              "expression": "V_{\\text{cone}} = \\tfrac{1}{3} \\pi r^2 h",
              "description": "Volume of a cone."
            },
            {
              "expression": "V_{\\text{pyramid}} = \\tfrac{1}{3} \\times \\text{base area} \\times h",
              "description": "Volume of a pyramid."
            }
          ]
        },
        {
          "name": "Coordinate Geometry",
          "description": "Formulas for points and lines on the plane.",
          "formulas": [
            {
              "expression": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}",
              "description": "Distance between two points."
            },
            {
              "expression": "\\text{Midpoint} = ((x_1+x_2)/2, (y_1+y_2)/2)",
              "description": "Midpoint of a line segment."
            },
            {
              "expression": "m = (y_2 - y_1)/(x_2 - x_1)",
              "description": "Slope of the line through two points."
            }
          ]
        }
      ]
    },
