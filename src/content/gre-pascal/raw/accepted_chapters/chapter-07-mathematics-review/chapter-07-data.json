  "examples": [
    {
      "id": 1,
      "source": "added example",
      "problem": "Find the gcd and lcm of 24 and 60.",
      "solution_steps": [
        "Factor 24 and 60 into primes: 24=2^3·3, 60=2^2·3·5.",
        "gcd uses the lowest exponents: 2^2·3=12.",
        "lcm uses the highest exponents: 2^3·3·5=120.",
        "Check that gcd·lcm = 24·60 = 1 440."
      ],
      "answer": {"gcd": 12, "lcm": 120}
    },
    {
      "id": 2,
      "source": "added example",
      "problem": "Simplify (3^4 · 3^{-2}) / 3^3.",
      "solution_steps": [
        "Combine exponents in the numerator: 3^4·3^{-2}=3^{4+(-2)}=3^2.",
        "Divide by 3^3: 3^2/3^3=3^{2-3}=3^{-1}.",
        "3^{-1} is 1/3."
      ],
      "answer": "1/3"
    },
    {
      "id": 3,
      "source": "added example",
      "problem": "A triangle has base 6 and height 4; find its area.",
      "solution_steps": [
        "Use area formula: 1/2·base·height.",
        "Substitute base=6, height=4: area=1/2·6·4=12."
      ],
      "answer": 12
    },
    {
      "id": 4,
      "source": "added example",
      "problem": "A right triangle has legs 9 and 12; find the hypotenuse.",
      "solution_steps": [
        "Apply the Pythagorean theorem: c^2=9^2+12^2=225.",
        "Take the square root: c=15."
      ],
      "answer": 15
    },
    {
      "id": 5,
      "source": "added example",
      "problem": "Arrange 3 books out of 5 and choose 3 out of 5 (order matters and does not matter).",
      "solution_steps": [
        "Permutations: P(5,3)=5!/(5-3)!=60.",
        "Combinations: C(5,3)=5!/(3!·2!)=10."
      ],
      "answer": {"permutations": 60, "combinations": 10}
    },
    {
      "id": 6,
      "source": "added example",
      "problem": "Roll a fair die; find P(odd or 4).",
      "solution_steps": [
        "Odd outcomes: 1,3,5 → 3/6.",
        "Outcome 4: 1/6.",
        "Add probabilities since events are mutually exclusive: 3/6+1/6=4/6=2/3."
      ],
      "answer": "2/3"
    },
    {
      "id": 7,
      "source": "added example",
      "problem": "Convert 2.5 miles to feet and 48 ounces to pounds.",
      "solution_steps": [
        "2.5 miles · 5,280 ft/mile = 13,200 ft.",
        "48 oz ÷ 16 oz/lb = 3 lb."
      ],
      "answer": {"feet": 13200, "pounds": 3}
    }
